# Apply NEMD with Langevin thermostat to heat source and sinks
# Set temperatures for heat source and sinks (heat source at 315K, sinks at 285K)
#computation

variable       kB        equal 0.00008617
variable       t         equal 300
variable       tlo       equal 285
variable       thi       equal 315
variable       tdamp     equal 0.05

compute        THSource  hot  temp
compute        THsink    cold  temp

timestep       0.0005

# 2nd equilibration run
# Keep the rest of the system in NVE (to conserve energy)

fix             hot hot langevin ${thi} ${thi} ${tdamp} 63741 tally yes zero yes
fix             hot hot langevin 315 ${thi} ${tdamp} 63741 tally yes zero yes
fix             hot hot langevin 315 315 ${tdamp} 63741 tally yes zero yes
fix             hot hot langevin 315 315 0.05 63741 tally yes zero yes
fix             cold cold langevin ${tlo} ${tlo} ${tdamp} 23458 tally yes zero yes
fix             cold cold langevin 285 ${tlo} ${tdamp} 23458 tally yes zero yes
fix             cold cold langevin 285 285 ${tdamp} 23458 tally yes zero yes
fix             cold cold langevin 285 285 0.05 23458 tally yes zero yes
fix_modify      hot temp THSource
fix_modify      cold temp THsink

variable        tdiff equal c_THSource-c_THsink
variable Time    equal step
variable EL      equal f_hot
variable ER      equal f_cold

thermo_style    custom step temp c_THSource c_THsink f_hot f_cold v_tdiff
thermo_modify   colname c_THSource Temp_hot colname c_THsink Temp_cold                 colname f_hot E_hot colname f_cold E_cold                 colname v_tdiff dTemp_step

thermo          1000
run             1000000
