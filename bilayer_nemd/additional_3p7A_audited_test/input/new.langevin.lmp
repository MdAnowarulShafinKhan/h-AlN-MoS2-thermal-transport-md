echo            both
units           metal
dimension       3
atom_style      atomic
neighbor        5.0 bin
neigh_modify    delay 0 every 1 check yes one 10000 page 100000    

#2 structure

boundary        p p f
read_data       MoS2_AlN.lmp

#3 potentials

pair_style 		hybrid sw tersoff lj/cut 10.0

# --- MoS2 intralayer (types 1-12); exclude AlN types with NULL ---

pair_coeff 		* * sw h-mos2.sw S1 Mo1 S2 S3 Mo2 S4 S5 Mo3 S6 S7 Mo4 S8  NULL NULL

# --- AlN intralayer (types 13-14); exclude MoS2 types with NULL ---

pair_coeff 		* * tersoff XN.tersoff  NULL NULL NULL NULL NULL NULL NULL NULL NULL NULL NULL NULL  Al N

# --- Cross-layer UFF LJ (epsilon=eV, sigma=Å) ---
# S types (1,3,4,6,7,9,10,12) with Al(13) and N(14)
# S-Al: eps=0.0161306349, sig=3.795841767

pair_coeff  	1 13 lj/cut 0.0161306349 3.795841767  10.0
pair_coeff  	3 13 lj/cut 0.0161306349 3.795841767  10.0
pair_coeff  	4 13 lj/cut 0.0161306349 3.795841767  10.0
pair_coeff  	6 13 lj/cut 0.0161306349 3.795841767  10.0
pair_coeff  	7 13 lj/cut 0.0161306349 3.795841767  10.0
pair_coeff  	9 13 lj/cut 0.0161306349 3.795841767  10.0
pair_coeff 		10 13 lj/cut 0.0161306349 3.795841767 10.0
pair_coeff 		12 13 lj/cut 0.0161306349 3.795841767 10.0

# S-N: eps=0.0059625264, sig=3.423660138

pair_coeff  	1 14 lj/cut 0.0059625264 3.423660138  10.0
pair_coeff  	3 14 lj/cut 0.0059625264 3.423660138  10.0
pair_coeff  	4 14 lj/cut 0.0059625264 3.423660138  10.0
pair_coeff  	6 14 lj/cut 0.0059625264 3.423660138  10.0
pair_coeff  	7 14 lj/cut 0.0059625264 3.423660138  10.0
pair_coeff  	9 14 lj/cut 0.0059625264 3.423660138  10.0
pair_coeff 		10 14 lj/cut 0.0059625264 3.423660138  10.0
pair_coeff 		12 14 lj/cut 0.0059625264 3.423660138  10.0

# Mo types (2,5,8,11) with Al(13) and N(14)
# Mo-Al: eps=0.0072923951, sig=3.301251376

pair_coeff  	2 13 lj/cut 0.0072923951 3.301251376  10.0
pair_coeff  	5 13 lj/cut 0.0072923951 3.301251376  10.0
pair_coeff  	8 13 lj/cut 0.0072923951 3.301251376  10.0
pair_coeff 		11 13 lj/cut 0.0072923951 3.301251376  10.0

# Mo-N: eps=0.0026955603, sig=2.977564249

pair_coeff  	2 14 lj/cut 0.0026955603 2.977564249  10.0
pair_coeff  	5 14 lj/cut 0.0026955603 2.977564249  10.0
pair_coeff  	8 14 lj/cut 0.0026955603 2.977564249  10.0
pair_coeff 		11 14 lj/cut 0.0026955603 2.977564249  10.0 

timestep        0.0005  # 0.5 fs timestep

# Define the regions for heat source and sinks

region       	hot block  2.59583289599736 15.57499737598416  INF INF  INF INF units box  
region       	cold block  242.00829222375184 255.98745670373864  INF INF  INF INF units box 

##region for fixed end

region          A1 block  INF 2.59583289599736  INF INF  INF INF units box
region          A2 block  255.98745670373864 INF  INF INF  INF INF units box
region          gFixed union 2 A1 A2

group            hot region hot
group            cold region cold
group            A1 region A1 
group            A2 region A2
group            gFixed region gFixed
group            gMobile subtract all gFixed

##Applying spring force to make the ends fixed

velocity         gFixed set 0.0 0.0 0.0
fix              fixEnds gFixed setforce 0.0 0.0 0.0

#4 optimize at 0 K

dump            1 all custom 50000 dump.minimization id type x y z
#fix		        1 all box/relax x 0.0 y 0.0
min_style       cg
min_style       cg
min_modify      line quadratic
minimize        1.0e-10 1.0e-6 100000 1000000

# ---------- Stage 2: fixed-box FIRE relaxation ----------
min_style       fire
minimize        1.0e-10 1.0e-6 100000 1000000

# ---------- Optional Stage 3: final CG cleanup ----------
min_style       cg
min_modify      line quadratic
minimize        1.0e-10 1.0e-7 100000 1000000
undump          1
#unfix			1

#5 optimize at 300K

compute         peratom all pe/atom
reset_timestep  0
timestep        0.0005

velocity        gMobile create 300 85293 rot yes mom yes dist gaussian

#fix             3 gMobile npt temp 300 300 0.05 x 0.0 0.0 0.5 y 0.0 0.0 0.5 couple xy 				#iso 0.0 0.0 0.5                        
#thermo          1000
#thermo_style    custom step temp  lx ly lz pxx pyy pzz etotal
#run             1000000
#unfix           3

fix             4 gMobile nvt temp 300 300 0.05
thermo          1000
thermo_style    custom step temp  lx ly lz pxx pyy pzz etotal
run             1000000
unfix           4

# Switch to NVE ensemble for 500 ps

fix             5 gMobile nve
run             1000000

# Apply NEMD with Langevin thermostat to heat source and sinks
# Set temperatures for heat source and sinks (heat source at 315K, sinks at 285K)
#computation

variable       kB        equal 0.00008617
variable       t         equal 300
variable       tlo       equal 285
variable       thi       equal 315
variable       tdamp     equal 0.05

compute        THSource  hot  temp
compute        THsink    cold  temp

timestep       0.0005	

# 2nd equilibration run
# Keep the rest of the system in NVE (to conserve energy)

fix             hot hot langevin ${thi} ${thi} ${tdamp} 85294 tally yes zero yes 
fix             cold cold langevin ${tlo} ${tlo} ${tdamp} 85295 tally yes zero yes 
fix_modify      hot temp THSource
fix_modify      cold temp THsink

variable        tdiff equal c_THSource-c_THsink
variable Time    equal step
variable EL      equal f_hot
variable ER      equal f_cold

thermo_style    custom step temp c_THSource c_THsink f_hot f_cold v_tdiff 
thermo_modify   colname c_THSource Temp_hot colname c_THsink Temp_cold &
                colname f_hot E_hot colname f_cold E_cold &
                colname v_tdiff dTemp_step  

thermo          1000
run             1000000

#3rd stage (NEMD)

reset_timestep  0

unfix           hot
unfix           cold

compute         ke all ke/atom
variable        temp atom c_ke/(1.5*${kB})

fix             hot hot langevin ${thi} ${thi} ${tdamp} 85296 tally yes zero yes 
fix             cold cold langevin ${tlo} ${tlo} ${tdamp} 85297 tally yes zero yes
fix_modify      hot temp THSource
fix_modify      cold temp THsink

fix             ave gMobile ave/time 10 100 1000 v_tdiff ave running  
thermo_style    custom step temp c_THSource c_THsink f_hot f_cold v_tdiff f_ave
thermo_modify   colname c_THSource Temp_hot colname c_THsink Temp_cold &
                colname f_hot E_hot colname f_cold E_cold &
                colname v_tdiff dTemp_step colname f_ave dTemp
				
compute         layers gMobile chunk/atom bin/1d x lower 0.01 units reduced   
fix             temp_profile gMobile ave/chunk 10 100 1000 layers v_temp file profile.langevin 
fix 			E_out gMobile print 1000 "${Time}  ${EL}  ${ER}" file Ener_equ.dat title "Time  E_hot  E_cold" screen no

dump            1 all custom 50000 dump.optimize id type x y z c_peratom fx fy fz vx vy vz

#variable        start_time equal time
#variable        lx equal 228.251736
#variable        ly equal 119.80809 
#variable        lz equal 3.4
                 
run             12000000   # 8 ns for data collection

# kappa_MD      = 42.6400 W·m⁻¹·K⁻¹
# kappa_formula = 46.1723 W·m⁻¹·K⁻¹
